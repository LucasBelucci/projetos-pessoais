from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time
import re
import pandas as pd

driver = webdriver.Chrome()

# Acesse a página de login
driver.get("https://b2b.latam.gamescom.global/auth/users/sign_in")
time.sleep(3)

# Identifique os campos de e-mail e senha
email_field = driver.find_element(By.ID, "user_email")
password_field = driver.find_element(By.ID, "user_password")

# Preencha os campos com suas credenciais
email_field.send_keys("ncocchia@btlaw.com.br")
password_field.send_keys("nattycocchia")

# Envie o formulário
password_field.send_keys(Keys.RETURN)
time.sleep(5)

# Vai para a página 1 de empresas
driver.get("https://b2b.latam.gamescom.global/companies?page=1&permanent_cookies_close=true")
time.sleep(5)

all_links = set()
page_count = 1
max_pages = 95  # Limite de páginas para teste

# 1. Coleta dos links das empresas, ignorando os de mensagens
while page_count <= max_pages:
    time.sleep(3)

    buttons = driver.find_elements(By.CLASS_NAME, "c-btn--secondary")
    for btn in buttons:
        href = btn.get_attribute("href")
        if href and "/messages/" not in href:  # Ignora links de mensagem
            all_links.add(href)

    try:
        page_count += 1
        next_url = f"https://b2b.latam.gamescom.global/companies?page={page_count}&permanent_cookies_close=true"
        print(f"➡️ Indo para a página {page_count}: {next_url}")
        driver.get(next_url)
    except:
        print("🚫 Nenhuma próxima página encontrada.")
        break

print(f"🔗 Total de empresas coletadas: {len(all_links)}")

# 2. Extração de dados das empresas
contatos = []

for link in all_links:
    # Garante que o link não é de mensagem (evita redirecionamento acidental)
    if "/messages/" in link:
        continue

    driver.get(link)
    time.sleep(3)

    try:
        nome_empresa = driver.find_element(By.TAG_NAME, "h1").text.strip()
    except:
        nome_empresa = "N/A"

    try:
        pais = driver.find_element(By.CLASS_NAME, "u-plain-list").text.strip()
    except:
        pais = "N/A"

    try:
        setor = driver.find_element(By.CLASS_NAME, "company-profile__categories").text.strip()
    except:
        setor = "N/A"

    body_text = driver.find_element(By.TAG_NAME, "body").text
    emails = re.findall(r'[\w\.-]+@[\w\.-]+\.\w+', body_text)

    telefones = []
    spans = driver.find_elements(By.CSS_SELECTOR, "span.u-blur small")
    for span in spans:
        txt = span.text.strip()
        if "Cel." in txt or "Tel." in txt:
            telefones.append(txt)

    contatos.append({
        'nome_empresa': nome_empresa,
        'url': link,
        #'pais': pais,
        #'setor': setor,
        'emails': emails,
        'telefones': telefones
    })

driver.quit()

# 3. Salvar em CSV
df = pd.DataFrame(contatos)
df['emails'] = df['emails'].apply(lambda x: ', '.join(x))
df['telefones'] = df['telefones'].apply(lambda x: ', '.join(x))
df.to_csv("contatos_gamescom.csv", index=False, encoding='utf-8-sig')
print("📁 Dados salvos em 'contatos_gamescom.csv'")
